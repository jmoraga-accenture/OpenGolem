{
  "allowedRoots": [
    {
      "path": "~/workspace",
      "allowReadWrite": true,
      "description": "Primary workspace directory"
    },
    {
      "path": "~/src",
      "allowReadWrite": true,
      "description": "Source code root"
    },
    {
      "path": "~/data/shared",
      "allowReadWrite": false,
      "description": "Shared data files (read-only)"
    }
  ],
  "blockedPatterns": [
    ".ssh",
    ".gnupg",
    "credentials",
    ".env"
  ],
  "nonMainReadOnly": true
}
