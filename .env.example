# Channels: comma-separated. Default when unset is `tui` only (no Telegram probe).
# OPENGOLEM_CHANNELS=tui
# OPENGOLEM_CHANNELS=tui,telegram

# Anthropic (see CLAUDE.md for full list)
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Credential backend (default: env — reads from this file)
# Options: env | bitwarden | onecli
# OPENGOLEM_CREDENTIAL_BACKEND=env

# Bitwarden backend (requires OPENGOLEM_CREDENTIAL_BACKEND=bitwarden)
# BW_SESSION=<session-key from `bw unlock`>
# BW_ITEM_NAME=opengolem-api-key      # item name in your vault
# BW_FIELD_NAME=credential            # custom field holding the key/token value

# OneCLI Agent Vault backend (requires OPENGOLEM_CREDENTIAL_BACKEND=onecli)
# ONECLI_GATEWAY_URL=http://127.0.0.1:4000
# ONECLI_GATEWAY_TOKEN=<bearer-token>
