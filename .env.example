# Channels: comma-separated. Default when unset is `tui` only (no Telegram probe).
# OPENGOLEM_CHANNELS=tui
# OPENGOLEM_CHANNELS=tui,telegram

# Anthropic (see CLAUDE.md for full list)
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Credential backend (default: env — reads from this file)
# Options: env | bitwarden | onecli
# OPENGOLEM_CREDENTIAL_BACKEND=env

# Bitwarden backend (requires OPENGOLEM_CREDENTIAL_BACKEND=bitwarden)
# BW_SESSION=<session-key from `bw unlock`>
# BW_ITEM_NAME=opengolem-api-key      # item name in your vault
# BW_FIELD_NAME=credential            # custom field holding the key/token value

# OneCLI Agent Vault backend (requires OPENGOLEM_CREDENTIAL_BACKEND=onecli)
# ONECLI_GATEWAY_URL=http://127.0.0.1:4000
# ONECLI_GATEWAY_TOKEN=<bearer-token>

# Call Inspector (M3)
# Security mode: golem_guard (default) | supervised | power
# OPENGOLEM_SECURITY_MODE=golem_guard
# Max API calls per minute across all containers (default: 60)
# INSPECTOR_RATE_LIMIT=60

# Telegram (M4)
# Default: direct messages only. Set to 1/true/yes to allow groups/supergroups.
# Every registered tg: group/supergroup then needs an explicit allowlist:
# TELEGRAM_VALID_USERS and/or per-chat rules in ~/.config/opengolem/sender-allowlist.json
# (per-chat "allow" cannot be *). Others' messages are still filtered from the agent.
# TELEGRAM_ALLOW_GROUPS=1
#
# Mandatory: comma-separated numeric user IDs (Telegram `from.id`).
# Only these users can message the bot. Empty or unset = no access from anyone (fail-secure).
TELEGRAM_VALID_USERS=
# TELEGRAM_BOT_TOKEN=<telegram_bot_token from @BotFather>
